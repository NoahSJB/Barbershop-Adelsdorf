# Barber Shop Adelsdorf – Apache-Konfiguration (Strato)

# Eigene 404-Seite
ErrorDocument 404 /404.html

# Verzeichnisauflistung verhindern
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # /index.html auf die Startseite umleiten (verhindert doppelte Inhalte bei Google)
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]

  # Kurzadresse für die Online-Buchung: barbershop-adelsdorf.de/terminbuchung
  RewriteRule ^terminbuchung/?$ https://termin.barbershop-adelsdorf.de/ [R=302,L]

  # --- Einheitliche Adresse: www -> ohne www (immer HTTPS) ---------------------
  # Die Umleitung von http auf https erledigt STRATO bereits selbst
  # (deshalb hier keine eigene HTTPS-Regel, das würde eine Endlosschleife riskieren).
  RewriteCond %{HTTP_HOST} ^www\.barbershop-adelsdorf\.de$ [NC]
  RewriteRule ^ https://barbershop-adelsdorf.de%{REQUEST_URI} [R=301,L]
</IfModule>

# Zeichensatz
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# Sicherheits-Header
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  # Browser merken sich für ein Jahr, dass diese Seite nur verschlüsselt aufgerufen wird
  Header always set Strict-Transport-Security "max-age=31536000"
  # Nur eigene Skripte, Schriften und Bilder. Fremde Inhalte kann die Seite damit gar nicht laden.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'"
</IfModule>

# Komprimierung
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json application/manifest+json text/plain application/xml
</IfModule>

# Browser-Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
